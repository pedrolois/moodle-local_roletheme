<div class="local-roletheme-simulation">
    {{#hasissues}}
        {{#issues}}
            <div class="alert alert-warning">{{message}}</div>
        {{/issues}}
    {{/hasissues}}

    {{#showokmessage}}
        <div class="alert alert-success">{{okmessage}}</div>
    {{/showokmessage}}

    {{{formhtml}}}

    {{#hasresult}}
        <h3>{{resulttitle}}</h3>
        <div class="table-responsive">
            <table class="generaltable table table-striped">
                <thead>
                    <tr>
                        <th scope="col">{{headers.setting}}</th>
                        <th scope="col">{{headers.value}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                        <tr>
                            <th scope="row">{{label}}</th>
                            <td>{{value}}</td>
                        </tr>
                    {{/rows}}
                </tbody>
            </table>
        </div>
    {{/hasresult}}

    {{#showempty}}
        <div class="alert alert-info">{{emptymessage}}</div>
    {{/showempty}}
</div>
